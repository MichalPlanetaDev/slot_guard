{
  "name": "SlotGuard",
  "dockerComposeFile": "compose.yaml",
  "service": "app",
  "workspaceFolder": "/workspaces/slot_guard",
  "forwardPorts": [3000],
  "portsAttributes": {
    "3000": {
      "label": "SlotGuard",
      "onAutoForward": "openPreview"
    }
  },
  "postCreateCommand": "bundle install && bin/rails db:prepare && bin/rails tailwindcss:build",
  "postStartCommand": "rm -f tmp/pids/server.pid && nohup bin/rails server -b 0.0.0.0 > /tmp/slotguard.log 2>&1 &",
  "remoteUser": "vscode"
}
