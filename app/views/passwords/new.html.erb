<% content_for :title, "Reset password" %>
<% content_for :description, "Request a SlotGuard password reset link." %>
<% content_for :auth_heading, "Reset your password" %>
<% content_for :auth_description, "Enter your account email. The reset link expires after 15 minutes." %>

<%= form_with url: passwords_path, class: "space-y-5" do |form| %>
  <div>
    <%= form.label :email_address, "Email address", class: "form-label" %>
    <%= form.email_field :email_address,
      required: true,
      autofocus: true,
      autocomplete: "username",
      inputmode: "email",
      value: params[:email_address],
      placeholder: "ada@example.com",
      class: "form-input" %>
  </div>

  <%= form.submit "Send reset instructions",
    class: "button-primary w-full cursor-pointer" %>
<% end %>

<p class="mt-6 text-center text-sm">
  <%= link_to "Return to sign in",
    new_session_path,
    class: "text-link" %>
</p>
