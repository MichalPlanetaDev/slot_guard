<% content_for :title, "Workspace settings" %>
<% content_for :description, "Identity and local time settings for #{Current.workspace.name}." %>

<main id="main-content" class="mx-auto max-w-3xl px-4 py-8 sm:px-6 sm:py-12 lg:px-8">
  <header>
    <p class="text-sm font-semibold uppercase tracking-[0.16em] text-emerald-700">
      Workspace administration
    </p>

    <h1 class="mt-3 text-3xl font-bold tracking-tight text-slate-950 sm:text-4xl">
      Workspace settings
    </h1>

    <p class="mt-3 max-w-2xl text-base leading-7 text-slate-600">
      The workspace time zone controls availability, reservation entry, and
      every booking time shown to members.
    </p>
  </header>

  <section class="mt-8 rounded-2xl border border-slate-200 bg-white p-6 shadow-sm sm:p-8">
    <%= render "shared/form_errors",
      record: @workspace %>

    <%= form_with model: @workspace,
      url: workspace_settings_path,
      method: :patch,
      class: "space-y-6" do |form| %>
      <div>
        <%= form.label :name,
          "Workspace name",
          class: "form-label" %>

        <%= form.text_field :name,
          required: true,
          maxlength: 100,
          autocomplete: "organization",
          class: "form-input" %>
      </div>

      <div>
        <%= form.label :time_zone,
          "Time zone",
          class: "form-label" %>

        <%= form.select :time_zone,
          Workspace.time_zone_options,
          {},
          class: "form-input" %>

        <p class="mt-2 text-sm leading-6 text-slate-500">
          Values are stored as IANA identifiers. Existing reservations keep
          the same instant; only their local presentation changes.
        </p>
      </div>

      <div class="rounded-xl border border-slate-200 bg-slate-50 p-4">
        <p class="text-xs font-semibold uppercase tracking-wide text-slate-500">
          Current local time
        </p>

        <% if @workspace.errors[:time_zone].empty? %>
          <p class="mt-2 text-base font-bold text-slate-950">
            <%= @workspace.local_time(Time.current).strftime(
              "%A, %B %-d, %Y at %H:%M"
            ) %>
          </p>

          <p class="mt-1 text-sm text-slate-500">
            <%= @workspace.time_zone %>
          </p>
        <% else %>
          <p class="mt-2 text-sm leading-6 text-slate-600">
            Choose a valid time zone to preview the workspace clock.
          </p>
        <% end %>
      </div>

      <div class="flex flex-col-reverse gap-3 border-t border-slate-200 pt-6 sm:flex-row sm:justify-end">
        <%= link_to "Cancel",
          dashboard_path,
          class: "button-secondary" %>

        <%= form.submit "Save settings",
          class: "button-primary cursor-pointer" %>
      </div>
    <% end %>
  </section>
</main>
