<h1>Join <%= @workspace.name %> on SlotGuard</h1>

<p>
  <%= @inviter.name %> invited you to join
  <strong><%= @workspace.name %></strong>
  as a <%= @invitation.role %>.
</p>

<p>
  <%= link_to "Review invitation", @acceptance_url %>
</p>

<p>
  This invitation expires on
  <%= @invitation.expires_at.to_fs(:long) %>.
  The link can be accepted only once.
</p>
