<!DOCTYPE html>
<html lang="en" class="h-full bg-stone-50">
  <head>
    <%= render "shared/head" %>
  </head>

  <body class="min-h-full bg-stone-50 font-sans text-slate-900 antialiased">
    <a
      href="#main-content"
      class="fixed left-4 top-4 z-[60] -translate-y-24 rounded-lg bg-white px-4 py-2 font-semibold text-slate-950 shadow-lg transition focus:translate-y-0"
    >
      Skip to content
    </a>

    <%= render "shared/flash" %>

    <header class="border-b border-slate-200 bg-white">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="flex min-h-16 items-center justify-between gap-3">
          <%= link_to dashboard_path,
            class: "inline-flex items-center gap-3 rounded-lg focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-emerald-600" do %>
            <span class="flex size-10 items-center justify-center rounded-lg bg-slate-950 font-black text-emerald-300">
              SG
            </span>

            <span class="hidden lg:block">
              <span class="block text-sm font-bold tracking-tight text-slate-950">
                SlotGuard
              </span>

              <span class="block max-w-40 truncate text-xs text-slate-500">
                <%= Current.workspace.name %>
              </span>
            </span>
          <% end %>

          <nav class="flex items-center gap-1 overflow-x-auto" aria-label="Workspace">
            <% dashboard_active = current_page?(dashboard_path) %>
            <% resources_active = request.path.start_with?("/resources") %>
            <% reservations_active = request.path.start_with?("/reservations") %>

            <%= link_to "Dashboard",
              dashboard_path,
              class: "whitespace-nowrap rounded-lg px-3 py-2 text-sm font-semibold transition #{dashboard_active ? "bg-slate-100 text-slate-950" : "text-slate-600 hover:bg-slate-50 hover:text-slate-950"}" %>

            <%= link_to "Resources",
              shared_resources_path,
              class: "whitespace-nowrap rounded-lg px-3 py-2 text-sm font-semibold transition #{resources_active ? "bg-slate-100 text-slate-950" : "text-slate-600 hover:bg-slate-50 hover:text-slate-950"}" %>

            <%= link_to "Reservations",
              reservations_path,
              class: "whitespace-nowrap rounded-lg px-3 py-2 text-sm font-semibold transition #{reservations_active ? "bg-slate-100 text-slate-950" : "text-slate-600 hover:bg-slate-50 hover:text-slate-950"}" %>
          </nav>

          <div class="flex items-center gap-3">
            <div class="hidden text-right xl:block">
              <p class="text-sm font-semibold text-slate-900">
                <%= Current.user.name %>
              </p>

              <p class="text-xs capitalize text-slate-500">
                <%= current_membership.role %>
              </p>
            </div>

            <%= button_to "Sign out",
              session_path,
              method: :delete,
              class: "button-secondary whitespace-nowrap" %>
          </div>
        </div>
      </div>
    </header>

    <%= yield %>
  </body>
</html>
