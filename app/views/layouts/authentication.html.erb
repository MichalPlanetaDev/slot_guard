<!DOCTYPE html>
<html lang="en" class="h-full bg-slate-950">
  <head>
    <%= render "shared/head" %>
  </head>

  <body class="min-h-full bg-slate-950 font-sans antialiased">
    <a
      href="#main-content"
      class="fixed left-4 top-4 z-[60] -translate-y-24 rounded-lg bg-white px-4 py-2 font-semibold text-slate-950 shadow-lg transition focus:translate-y-0"
    >
      Skip to content
    </a>

    <%= render "shared/flash" %>

    <main
      id="main-content"
      class="grid min-h-screen lg:grid-cols-[minmax(0,1fr)_minmax(30rem,0.82fr)]"
    >
      <section class="hidden border-r border-white/10 bg-slate-950 p-12 text-white lg:flex lg:flex-col lg:justify-between">
        <%= link_to root_path,
          class: "inline-flex w-fit items-center gap-3 rounded-lg focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-emerald-400" do %>
          <span class="flex size-10 items-center justify-center rounded-lg bg-emerald-400 font-black text-slate-950">
            SG
          </span>
          <span class="text-lg font-bold tracking-tight">SlotGuard</span>
        <% end %>

        <div class="max-w-xl">
          <p class="text-sm font-semibold uppercase tracking-[0.18em] text-emerald-300">
            Shared resources, clearly managed
          </p>

          <h2 class="mt-5 text-4xl font-bold leading-tight tracking-tight">
            A dependable record of who booked what, when, and why.
          </h2>

          <p class="mt-5 max-w-lg text-base leading-7 text-slate-300">
            SlotGuard keeps room and equipment schedules understandable while
            protecting confirmed reservations from overlapping changes.
          </p>
        </div>

        <p class="text-sm text-slate-500">
          Built for small teams that need reliable availability.
        </p>
      </section>

      <section class="flex min-h-screen items-center justify-center bg-stone-50 px-4 py-10 sm:px-8 lg:px-12">
        <div class="w-full max-w-md">
          <%= link_to root_path,
            class: "mb-8 inline-flex items-center gap-3 rounded-lg text-slate-950 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-emerald-600 lg:hidden" do %>
            <span class="flex size-10 items-center justify-center rounded-lg bg-slate-950 font-black text-emerald-300">
              SG
            </span>
            <span class="text-lg font-bold tracking-tight">SlotGuard</span>
          <% end %>

          <header class="mb-7">
            <h1 class="text-3xl font-bold tracking-tight text-slate-950">
              <%= yield :auth_heading %>
            </h1>

            <p class="mt-2 text-sm leading-6 text-slate-600">
              <%= yield :auth_description %>
            </p>
          </header>

          <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm sm:p-8">
            <%= yield %>
          </div>
        </div>
      </section>
    </main>
  </body>
</html>
