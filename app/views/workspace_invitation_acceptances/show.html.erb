<% content_for :title, "Join #{@invitation.workspace.name}" %>
<% content_for :description, "Review your SlotGuard workspace invitation." %>

<div class="w-full max-w-xl">
  <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-xl shadow-slate-950/5 sm:p-8">
    <p class="text-sm font-semibold uppercase tracking-[0.16em] text-emerald-700">
      Workspace invitation
    </p>

    <h1 class="mt-4 text-3xl font-bold tracking-tight text-slate-950">
      Join <%= @invitation.workspace.name %>
    </h1>

    <p class="mt-4 text-base leading-7 text-slate-600">
      <strong class="text-slate-900"><%= @invitation.invited_by.name %></strong>
      invited
      <strong class="text-slate-900"><%= @invitation.email_address %></strong>
      to join as a
      <strong class="capitalize text-slate-900"><%= @invitation.role %></strong>.
    </p>

    <dl class="mt-6 divide-y divide-slate-200 rounded-xl bg-slate-50 px-4">
      <div class="grid gap-1 py-4 sm:grid-cols-[8rem_1fr]">
        <dt class="text-sm font-medium text-slate-500">
          Workspace
        </dt>

        <dd class="text-sm font-semibold text-slate-900">
          <%= @invitation.workspace.name %>
        </dd>
      </div>

      <div class="grid gap-1 py-4 sm:grid-cols-[8rem_1fr]">
        <dt class="text-sm font-medium text-slate-500">
          Access
        </dt>

        <dd class="text-sm font-semibold capitalize text-slate-900">
          <%= @invitation.role %>
        </dd>
      </div>

      <div class="grid gap-1 py-4 sm:grid-cols-[8rem_1fr]">
        <dt class="text-sm font-medium text-slate-500">
          Expires
        </dt>

        <dd class="text-sm font-semibold text-slate-900">
          <%= @invitation.workspace.local_time(@invitation.expires_at).to_fs(:long) %>
        </dd>
      </div>
    </dl>

    <% if @invitation.errors.any? %>
      <div class="mt-6">
        <%= render "shared/form_errors",
          record: @invitation %>
      </div>
    <% end %>

    <% if Current.user %>
      <% if Current.user.email_address.casecmp?(
        @invitation.email_address
      ) %>
        <%= button_to "Accept invitation",
          workspace_invitation_acceptance_path(@token),
          method: :patch,
          class: "button-primary mt-6 w-full" %>
      <% else %>
        <div class="mt-6 rounded-xl border border-amber-200 bg-amber-50 p-4">
          <p class="text-sm font-semibold text-amber-900">
            Different account required
          </p>

          <p class="mt-2 text-sm leading-6 text-amber-800">
            You are signed in as <%= Current.user.email_address %>.
            Sign in with <%= @invitation.email_address %> to accept.
          </p>
        </div>

        <%= button_to "Sign out",
          session_path,
          method: :delete,
          class: "button-secondary mt-4 w-full" %>
      <% end %>
    <% else %>
      <div class="mt-6 grid gap-3 sm:grid-cols-2">
        <%= link_to "Sign in",
          new_session_path,
          class: "button-primary" %>

        <%= link_to "Create account",
          new_registration_path,
          class: "button-secondary" %>
      </div>

      <p class="mt-4 text-center text-sm leading-6 text-slate-500">
        Sign in or register with <%= @invitation.email_address %>.
        Your personal workspace will remain available after you join.
      </p>
    <% end %>
  </div>
</div>
