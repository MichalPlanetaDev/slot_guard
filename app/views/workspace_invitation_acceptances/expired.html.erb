<% content_for :title, "Invitation expired" %>

<div class="w-full max-w-lg">
  <div class="rounded-2xl border border-slate-200 bg-white p-8 text-center shadow-xl shadow-slate-950/5">
    <span class="mx-auto flex size-14 items-center justify-center rounded-xl bg-amber-50 text-xl font-bold text-amber-700">
      SG
    </span>

    <h1 class="mt-5 text-2xl font-bold tracking-tight text-slate-950">
      Invitation expired
    </h1>

    <p class="mt-3 text-sm leading-6 text-slate-600">
      The invitation to <%= @invitation.workspace.name %> expired on
      <%= @invitation.expires_at.to_fs(:long) %>.
      Ask the workspace owner to resend it.
    </p>

    <%= link_to "Return to SlotGuard",
      root_path,
      class: "button-primary mt-6" %>
  </div>
</div>
