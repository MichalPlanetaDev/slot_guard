<% content_for :title, "Workspace team" %>
<% content_for :description, "Members and invitations for #{Current.workspace.name}." %>

<main id="main-content" class="mx-auto max-w-7xl px-4 py-8 sm:px-6 sm:py-12 lg:px-8">
  <header class="flex flex-col gap-5 lg:flex-row lg:items-end lg:justify-between">
    <div>
      <p class="text-sm font-semibold uppercase tracking-[0.16em] text-emerald-700">
        <%= Current.workspace.name %>
      </p>

      <h1 class="mt-3 text-3xl font-bold tracking-tight text-slate-950 sm:text-4xl">
        Workspace team
      </h1>

      <p class="mt-3 max-w-2xl text-base leading-7 text-slate-600">
        Review workspace access and the responsibilities assigned to each
        member.
      </p>
    </div>

    <div class="rounded-xl border border-slate-200 bg-white px-4 py-3 shadow-sm">
      <p class="text-xs font-semibold uppercase tracking-wide text-slate-500">
        Your access
      </p>

      <p class="mt-1 text-sm font-bold capitalize text-slate-950">
        <%= current_membership.role %>
      </p>
    </div>
  </header>

  <div class="mt-8 grid gap-6 xl:grid-cols-[minmax(0,1fr)_24rem]">
    <section class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
      <header class="border-b border-slate-200 px-5 py-4 sm:px-6">
        <h2 class="text-lg font-bold text-slate-950">
          Members
        </h2>

        <p class="mt-1 text-sm text-slate-500">
          <%= pluralize(@memberships.size, "person") %> with workspace access
        </p>
      </header>

      <div class="divide-y divide-slate-200">
        <% @memberships.each do |membership| %>
          <article class="px-5 py-5 sm:px-6">
            <div class="flex flex-col gap-4 lg:flex-row lg:items-center lg:justify-between">
              <div class="min-w-0">
                <div class="flex flex-wrap items-center gap-2">
                  <h3 class="truncate font-bold text-slate-950">
                    <%= membership.user.name %>
                  </h3>

                  <% if membership.user_id == Current.user.id %>
                    <span class="rounded-full bg-slate-100 px-2.5 py-1 text-xs font-semibold text-slate-600">
                      You
                    </span>
                  <% end %>

                  <span class="rounded-full px-2.5 py-1 text-xs font-semibold capitalize <%= membership.owner? ? "bg-violet-50 text-violet-800" : membership.manager? ? "bg-sky-50 text-sky-800" : "bg-emerald-50 text-emerald-800" %>">
                    <%= membership.role %>
                  </span>
                </div>

                <p class="mt-2 truncate text-sm text-slate-500">
                  <%= membership.user.email_address %>
                </p>

                <p class="mt-1 text-xs text-slate-400">
                  Joined <%= membership.created_at.to_date.to_fs(:long) %>
                </p>
              </div>

              <% if can_manage_members? && !membership.owner? %>
                <div class="flex flex-col gap-3 sm:flex-row sm:items-center">
                  <%= form_with model: membership,
                    url: workspace_membership_path(membership),
                    method: :patch,
                    class: "flex items-center gap-2" do |form| %>
                    <%= form.label :role,
                      "Role",
                      class: "sr-only" %>

                    <%= form.select :role,
                      [
                        ["Member", "member"],
                        ["Manager", "manager"]
                      ],
                      {},
                      class: "min-h-10 rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm text-slate-900 focus:border-emerald-600 focus:outline-none focus:ring-2 focus:ring-emerald-100" %>

                    <%= form.submit "Save",
                      class: "inline-flex min-h-10 cursor-pointer items-center justify-center rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm font-semibold text-slate-700 transition hover:bg-slate-50" %>
                  <% end %>

                  <%= button_to "Remove",
                    workspace_membership_path(membership),
                    method: :delete,
                    class: "inline-flex min-h-10 items-center justify-center rounded-lg border border-rose-200 bg-white px-3 py-2 text-sm font-semibold text-rose-700 transition hover:bg-rose-50",
                    form: {
                      data: {
                        turbo_confirm: "Remove #{membership.user.name}? Upcoming confirmed reservations must be cancelled first."
                      }
                    } %>
                </div>
              <% end %>
            </div>
          </article>
        <% end %>
      </div>
    </section>

    <aside class="space-y-6">
      <% if can_manage_members? %>
        <section class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
          <h2 class="text-lg font-bold text-slate-950">
            Invite a teammate
          </h2>

          <p class="mt-2 text-sm leading-6 text-slate-500">
            Links expire after seven days and can be accepted only by the
            invited email address.
          </p>

          <%= form_with model: @workspace_invitation,
            url: workspace_invitations_path,
            class: "mt-5 space-y-4" do |form| %>
            <div>
              <%= form.label :email_address,
                "Email address",
                class: "form-label" %>

              <%= form.email_field :email_address,
                required: true,
                maxlength: 254,
                autocomplete: "email",
                placeholder: "teammate@example.com",
                class: "form-input" %>
            </div>

            <div>
              <%= form.label :role,
                class: "form-label" %>

              <%= form.select :role,
                [
                  [
                    "Member — create reservations",
                    "member"
                  ],
                  [
                    "Manager — also manage resources",
                    "manager"
                  ]
                ],
                {},
                class: "form-input" %>
            </div>

            <%= form.submit "Send invitation",
              class: "button-primary w-full cursor-pointer" %>
          <% end %>
        </section>

        <section class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
          <header class="border-b border-slate-200 px-5 py-4">
            <h2 class="font-bold text-slate-950">
              Pending invitations
            </h2>

            <p class="mt-1 text-sm text-slate-500">
              Sending again replaces the previous link
            </p>
          </header>

          <% if @pending_invitations.any? %>
            <div class="divide-y divide-slate-200">
              <% @pending_invitations.each do |invitation| %>
                <article class="px-5 py-4">
                  <div class="flex items-start justify-between gap-3">
                    <div class="min-w-0">
                      <p class="truncate text-sm font-semibold text-slate-950">
                        <%= invitation.email_address %>
                      </p>

                      <p class="mt-1 text-xs capitalize text-slate-500">
                        <%= invitation.role %>
                        ·
                        <% if invitation.expired? %>
                          <span class="font-semibold text-rose-700">
                            Expired
                          </span>
                        <% else %>
                          Expires
                          <%= invitation.expires_at.to_date.to_fs(:long) %>
                        <% end %>
                      </p>

                      <p class="mt-1 text-xs text-slate-400">
                        Invited by <%= invitation.invited_by.name %>
                      </p>
                    </div>

                    <%= button_to "Revoke",
                      workspace_invitation_path(invitation),
                      method: :delete,
                      class: "text-sm font-semibold text-rose-700 hover:text-rose-900",
                      form: {
                        data: {
                          turbo_confirm: "Revoke the invitation for #{invitation.email_address}?"
                        }
                      } %>
                  </div>
                </article>
              <% end %>
            </div>
          <% else %>
            <div class="px-5 py-8 text-center">
              <p class="text-sm text-slate-500">
                No pending invitations.
              </p>
            </div>
          <% end %>
        </section>
      <% else %>
        <section class="rounded-2xl border border-slate-200 bg-slate-50 p-5">
          <h2 class="font-bold text-slate-950">
            Team administration
          </h2>

          <p class="mt-2 text-sm leading-6 text-slate-600">
            The workspace owner controls invitations, role changes, and member
            removal.
          </p>
        </section>
      <% end %>
    </aside>
  </div>
</main>
