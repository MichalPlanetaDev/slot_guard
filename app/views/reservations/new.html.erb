<% content_for :title, "New reservation" %>
<% content_for :description, "Reserve an available SlotGuard resource." %>

<main id="main-content" class="mx-auto max-w-3xl px-4 py-8 sm:px-6 sm:py-12 lg:px-8">
  <%= link_to "← Reservations",
    reservations_path,
    class: "text-link text-sm" %>

  <header class="mt-6">
    <h1 class="text-3xl font-bold tracking-tight text-slate-950">
      New reservation
    </h1>

    <p class="mt-3 text-base leading-7 text-slate-600">
      Choose an available <%= Current.workspace.time_zone %> time. Adjacent reservations are allowed, but
      confirmed reservations for the same resource cannot overlap.
    </p>
  </header>

  <% if @shared_resources.any? %>
    <section class="mt-8 rounded-2xl border border-slate-200 bg-white p-6 shadow-sm sm:p-8">
      <%= render "form",
        reservation: @reservation,
        shared_resources: @shared_resources %>
    </section>
  <% else %>
    <section class="mt-8 rounded-2xl border border-dashed border-slate-300 bg-white px-6 py-16 text-center">
      <h2 class="text-lg font-bold text-slate-950">
        No active resources
      </h2>

      <p class="mx-auto mt-2 max-w-md text-sm leading-6 text-slate-500">
        An owner or manager must add and activate a resource before the
        workspace can create reservations.
      </p>

      <%= link_to "View resources",
        shared_resources_path,
        class: "button-secondary mt-6" %>
    </section>
  <% end %>
</main>
