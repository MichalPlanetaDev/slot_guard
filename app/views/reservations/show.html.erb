<% content_for :title, @reservation.purpose %>
<% content_for :description, "Reservation details for #{@reservation.shared_resource.name}." %>

<main id="main-content" class="mx-auto max-w-4xl px-4 py-8 sm:px-6 sm:py-12 lg:px-8">
  <%= link_to "← Reservations",
    reservations_path,
    class: "text-link text-sm" %>

  <header class="mt-6 flex flex-col gap-5 sm:flex-row sm:items-start sm:justify-between">
    <div>
      <div class="flex flex-wrap items-center gap-2">
        <span class="rounded-full px-3 py-1 text-xs font-semibold <%= @reservation.confirmed? ? "bg-emerald-50 text-emerald-800" : "bg-slate-200 text-slate-700" %>">
          <%= @reservation.status.humanize %>
        </span>

        <span class="rounded-full bg-slate-100 px-3 py-1 text-xs font-semibold text-slate-700">
          <%= @reservation.shared_resource.category.humanize %>
        </span>
      </div>

      <h1 class="mt-4 text-3xl font-bold tracking-tight text-slate-950 sm:text-4xl">
        <%= @reservation.purpose %>
      </h1>

      <p class="mt-3 text-base text-slate-600">
        <%= link_to @reservation.shared_resource.name,
          @reservation.shared_resource,
          class: "text-link" %>
      </p>
    </div>

    <% if @reservation.cancellable_by?(
      Current.user,
      membership: current_membership
    ) %>
      <%= button_to "Cancel reservation",
        cancel_reservation_path(@reservation),
        method: :patch,
        class: "inline-flex min-h-11 items-center justify-center rounded-lg border border-rose-200 bg-white px-4 py-2.5 text-sm font-semibold text-rose-700 transition hover:bg-rose-50 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-rose-600",
        form: {
          data: {
            turbo_confirm: "Cancel this reservation? The time will become available immediately."
          }
        } %>
    <% end %>
  </header>

  <section class="mt-8 rounded-2xl border border-slate-200 bg-white p-6 shadow-sm sm:p-8">
    <dl class="divide-y divide-slate-200">
      <div class="grid gap-1 py-4 sm:grid-cols-[11rem_1fr]">
        <dt class="text-sm font-medium text-slate-500">
          Date
        </dt>

        <dd class="text-sm font-semibold text-slate-900">
          <%= @reservation.starts_at.to_date.to_fs(:long) %>
        </dd>
      </div>

      <div class="grid gap-1 py-4 sm:grid-cols-[11rem_1fr]">
        <dt class="text-sm font-medium text-slate-500">
          Time
        </dt>

        <dd class="text-sm font-semibold text-slate-900">
          <%= @reservation.starts_at.to_fs(:time) %>–<%= @reservation.ends_at.to_fs(:time) %>
          UTC
        </dd>
      </div>

      <div class="grid gap-1 py-4 sm:grid-cols-[11rem_1fr]">
        <dt class="text-sm font-medium text-slate-500">
          Reserved by
        </dt>

        <dd class="text-sm font-semibold text-slate-900">
          <%= @reservation.user.name %>
        </dd>
      </div>

      <div class="grid gap-1 py-4 sm:grid-cols-[11rem_1fr]">
        <dt class="text-sm font-medium text-slate-500">
          Notes
        </dt>

        <dd class="whitespace-pre-line text-sm leading-6 text-slate-700">
          <%= @reservation.notes.presence || "No notes recorded." %>
        </dd>
      </div>

      <% if @reservation.cancelled? %>
        <div class="grid gap-1 py-4 sm:grid-cols-[11rem_1fr]">
          <dt class="text-sm font-medium text-slate-500">
            Cancelled
          </dt>

          <dd class="text-sm text-slate-700">
            <%= @reservation.cancelled_at.to_fs(:long) %>
            by
            <%= @reservation.cancelled_by.name %>
          </dd>
        </div>
      <% end %>
    </dl>
  </section>
</main>
