<% content_for :title, @shared_resource.name %>
<% content_for :description, "Details for #{@shared_resource.name} in SlotGuard." %>

<main id="main-content" class="mx-auto max-w-5xl px-4 py-8 sm:px-6 sm:py-12 lg:px-8">
  <%= link_to "← Resources",
    shared_resources_path(
      status: @shared_resource.active? ? "active" : "archived"
    ),
    class: "text-link text-sm" %>

  <header class="mt-6 flex flex-col gap-5 sm:flex-row sm:items-start sm:justify-between">
    <div class="min-w-0">
      <div class="flex flex-wrap items-center gap-2">
        <span class="rounded-full px-3 py-1 text-xs font-semibold <%= @shared_resource.room? ? "bg-sky-50 text-sky-800" : "bg-amber-50 text-amber-800" %>">
          <%= @shared_resource.category.humanize %>
        </span>

        <span class="rounded-full px-3 py-1 text-xs font-semibold <%= @shared_resource.active? ? "bg-emerald-50 text-emerald-800" : "bg-slate-200 text-slate-700" %>">
          <%= @shared_resource.active? ? "Active" : "Archived" %>
        </span>
      </div>

      <h1 class="mt-4 break-words text-3xl font-bold tracking-tight text-slate-950 sm:text-4xl">
        <%= @shared_resource.name %>
      </h1>

      <p class="mt-3 text-base text-slate-600">
        <%= @shared_resource.location.presence || "No location recorded" %>
      </p>
    </div>

    <% if can_manage_resources? %>
      <div class="flex shrink-0 flex-wrap gap-3">
        <%= link_to "Edit",
          edit_shared_resource_path(@shared_resource),
          class: "button-secondary" %>

        <% if @shared_resource.active? %>
          <%= button_to "Archive",
            archive_shared_resource_path(@shared_resource),
            method: :patch,
            class: "inline-flex min-h-11 items-center justify-center rounded-lg border border-rose-200 bg-white px-4 py-2.5 text-sm font-semibold text-rose-700 transition hover:bg-rose-50 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-rose-600",
            form: {
              data: {
                turbo_confirm: "Archive #{@shared_resource.name}? It will no longer be available for new bookings."
              }
            } %>
        <% else %>
          <%= button_to "Restore",
            restore_shared_resource_path(@shared_resource),
            method: :patch,
            class: "button-primary" %>
        <% end %>
      </div>
    <% end %>
  </header>

  <div class="mt-8 grid gap-6 lg:grid-cols-[minmax(0,1fr)_18rem]">
    <section class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
      <h2 class="text-lg font-bold text-slate-950">
        Resource details
      </h2>

      <dl class="mt-6 divide-y divide-slate-200">
        <div class="grid gap-1 py-4 sm:grid-cols-[10rem_1fr]">
          <dt class="text-sm font-medium text-slate-500">
            Type
          </dt>

          <dd class="text-sm font-semibold text-slate-900">
            <%= @shared_resource.category.humanize %>
          </dd>
        </div>

        <div class="grid gap-1 py-4 sm:grid-cols-[10rem_1fr]">
          <dt class="text-sm font-medium text-slate-500">
            Capacity
          </dt>

          <dd class="text-sm font-semibold text-slate-900">
            <%= @shared_resource.capacity || "Not specified" %>
          </dd>
        </div>

        <div class="grid gap-1 py-4 sm:grid-cols-[10rem_1fr]">
          <dt class="text-sm font-medium text-slate-500">
            Description
          </dt>

          <dd class="whitespace-pre-line text-sm leading-6 text-slate-700">
            <%= @shared_resource.description.presence || "No description recorded." %>
          </dd>
        </div>
      </dl>
    </section>

    <aside class="rounded-2xl border border-slate-200 bg-slate-50 p-5">
      <h2 class="text-sm font-bold text-slate-950">
        Record history
      </h2>

      <dl class="mt-4 space-y-4 text-sm">
        <div>
          <dt class="text-slate-500">Added</dt>
          <dd class="mt-1 font-medium text-slate-800">
            <%= @shared_resource.created_at.to_fs(:long) %>
          </dd>
        </div>

        <div>
          <dt class="text-slate-500">Last updated</dt>
          <dd class="mt-1 font-medium text-slate-800">
            <%= @shared_resource.updated_at.to_fs(:long) %>
          </dd>
        </div>
      </dl>
    </aside>
  </div>
</main>
