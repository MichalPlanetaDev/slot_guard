<% content_for :title, "Add resource" %>
<% content_for :description, "Add a room or equipment resource to SlotGuard." %>

<main id="main-content" class="mx-auto max-w-3xl px-4 py-8 sm:px-6 sm:py-12 lg:px-8">
  <%= link_to "← Resources",
    shared_resources_path,
    class: "text-link text-sm" %>

  <header class="mt-6">
    <h1 class="text-3xl font-bold tracking-tight text-slate-950">
      Add a shared resource
    </h1>

    <p class="mt-3 text-base leading-7 text-slate-600">
      Record the room or equipment identity now. Availability rules will be
      configured separately from descriptive details.
    </p>
  </header>

  <section class="mt-8 rounded-2xl border border-slate-200 bg-white p-6 shadow-sm sm:p-8">
    <%= render "form", shared_resource: @shared_resource %>
  </section>
</main>
