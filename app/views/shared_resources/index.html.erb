<% content_for :title, "Resources" %>
<% content_for :description, "Rooms and equipment in your SlotGuard workspace." %>

<main id="main-content" class="mx-auto max-w-7xl px-4 py-8 sm:px-6 sm:py-12 lg:px-8">
  <header class="flex flex-col gap-5 sm:flex-row sm:items-end sm:justify-between">
    <div>
      <p class="text-sm font-semibold uppercase tracking-[0.16em] text-emerald-700">
        <%= Current.workspace.name %>
      </p>

      <h1 class="mt-3 text-3xl font-bold tracking-tight text-slate-950 sm:text-4xl">
        Shared resources
      </h1>

      <p class="mt-3 max-w-2xl text-base leading-7 text-slate-600">
        Rooms and equipment available to this workspace. Archived resources
        remain visible without appearing as active booking options.
      </p>
    </div>

    <div class="flex shrink-0 flex-wrap gap-3">
      <%= link_to "Blackout periods",
        blackout_periods_path,
        class: "button-secondary" %>

      <% if can_manage_resources? %>
        <%= link_to "Add resource",
          new_shared_resource_path,
          class: "button-primary" %>
      <% end %>
    </div>
  </header>

  <nav class="mt-8 flex gap-2 border-b border-slate-200" aria-label="Resource status">
    <%= link_to "Active",
      shared_resources_path(status: "active"),
      class: "border-b-2 px-3 py-3 text-sm font-semibold #{@status == "active" ? "border-emerald-600 text-emerald-800" : "border-transparent text-slate-500 hover:text-slate-900"}" %>

    <%= link_to "Archived",
      shared_resources_path(status: "archived"),
      class: "border-b-2 px-3 py-3 text-sm font-semibold #{@status == "archived" ? "border-emerald-600 text-emerald-800" : "border-transparent text-slate-500 hover:text-slate-900"}" %>
  </nav>

  <% if @shared_resources.any? %>
    <section class="mt-6 grid gap-4 md:grid-cols-2 xl:grid-cols-3" aria-label="<%= @status.humanize %> resources">
      <% @shared_resources.each do |shared_resource| %>
        <%= link_to shared_resource,
          class: "group rounded-2xl border border-slate-200 bg-white p-5 shadow-sm transition hover:-translate-y-0.5 hover:border-slate-300 hover:shadow-md focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-emerald-600" do %>
          <div class="flex items-start justify-between gap-4">
            <span class="rounded-full px-3 py-1 text-xs font-semibold <%= shared_resource.room? ? "bg-sky-50 text-sky-800" : "bg-amber-50 text-amber-800" %>">
              <%= shared_resource.category.humanize %>
            </span>

            <span class="rounded-full px-3 py-1 text-xs font-semibold <%= shared_resource.active? ? "bg-emerald-50 text-emerald-800" : "bg-slate-100 text-slate-600" %>">
              <%= shared_resource.active? ? "Active" : "Archived" %>
            </span>
          </div>

          <h2 class="mt-5 text-lg font-bold text-slate-950 group-hover:text-emerald-800">
            <%= shared_resource.name %>
          </h2>

          <p class="mt-2 min-h-6 text-sm text-slate-500">
            <%= shared_resource.location.presence || "Location not specified" %>
          </p>

          <dl class="mt-5 border-t border-slate-100 pt-4 text-sm">
            <div class="flex items-center justify-between gap-4">
              <dt class="text-slate-500">Capacity</dt>
              <dd class="font-semibold text-slate-800">
                <%= shared_resource.capacity || "Not set" %>
              </dd>
            </div>
          </dl>
        <% end %>
      <% end %>
    </section>
  <% else %>
    <section class="mt-6 rounded-2xl border border-dashed border-slate-300 bg-white px-6 py-16 text-center">
      <h2 class="text-lg font-bold text-slate-950">
        No <%= @status %> resources
      </h2>

      <p class="mx-auto mt-2 max-w-md text-sm leading-6 text-slate-500">
        <% if @status == "active" %>
          Add a room or piece of equipment to establish the workspace
          inventory.
        <% else %>
          Resources that are no longer bookable will remain available here.
        <% end %>
      </p>

      <% if @status == "active" && can_manage_resources? %>
        <%= link_to "Add resource",
          new_shared_resource_path,
          class: "button-primary mt-6" %>
      <% end %>
    </section>
  <% end %>
</main>
