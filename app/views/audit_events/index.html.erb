<% content_for :title, "Activity" %>
<% content_for :description, "Recent activity in your SlotGuard workspace." %>

<main id="main-content" class="mx-auto max-w-5xl px-4 py-8 sm:px-6 sm:py-12 lg:px-8">
  <header>
    <p class="text-sm font-semibold uppercase tracking-[0.16em] text-emerald-700">
      <%= Current.workspace.name %>
    </p>

    <h1 class="mt-3 text-3xl font-bold tracking-tight text-slate-950 sm:text-4xl">
      Workspace activity
    </h1>

    <p class="mt-3 max-w-2xl text-base leading-7 text-slate-600">
      <% if current_membership.owner? %>
        Important scheduling, resource, and workspace administration events.
      <% elsif current_membership.manager? %>
        Scheduling and resource activity available to workspace managers.
      <% else %>
        Creation and cancellation activity for your reservations.
      <% end %>
    </p>
  </header>

  <% if @audit_events.any? %>
    <section class="mt-8 overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm" aria-label="Recent activity">
      <ol class="divide-y divide-slate-200">
        <% @audit_events.each do |event| %>
          <li class="px-5 py-5 sm:px-6">
            <div class="flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between">
              <div class="min-w-0">
                <div class="flex flex-wrap items-center gap-2">
                  <span class="rounded-full bg-slate-100 px-3 py-1 text-xs font-semibold capitalize text-slate-700">
                    <%= event.category %>
                  </span>

                  <span class="text-xs font-medium text-slate-500">
                    <%= event.actor_name %>
                  </span>
                </div>

                <p class="mt-3 text-sm font-semibold leading-6 text-slate-950">
                  <%= event.message %>
                </p>

                <p class="mt-1 truncate text-sm text-slate-500">
                  <%= event.subject_name %>
                </p>
              </div>

              <time
                datetime="<%= event.created_at.iso8601 %>"
                class="shrink-0 text-xs font-medium text-slate-500"
              >
                <%= workspace_local_time(event.created_at).to_fs(:long) %>
                <%= Current.workspace.time_zone %>
              </time>
            </div>
          </li>
        <% end %>
      </ol>
    </section>
  <% else %>
    <section class="mt-8 rounded-2xl border border-dashed border-slate-300 bg-white px-6 py-16 text-center">
      <h2 class="text-lg font-bold text-slate-950">
        No activity yet
      </h2>

      <p class="mx-auto mt-2 max-w-md text-sm leading-6 text-slate-500">
        Relevant workspace actions will appear here as they happen.
      </p>
    </section>
  <% end %>
</main>
