<% content_for :title, "Dashboard" %>
<% content_for :description, "Your SlotGuard workspace." %>

<div class="min-h-screen bg-stone-50">
  <header class="border-b border-slate-200 bg-white">
    <div class="mx-auto flex max-w-7xl items-center justify-between gap-6 px-4 py-4 sm:px-6 lg:px-8">
      <%= link_to dashboard_path,
        class: "inline-flex items-center gap-3 rounded-lg focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-emerald-600" do %>
        <span class="flex size-10 items-center justify-center rounded-lg bg-slate-950 font-black text-emerald-300">
          SG
        </span>
        <span class="text-lg font-bold tracking-tight text-slate-950">
          SlotGuard
        </span>
      <% end %>

      <div class="flex items-center gap-3">
        <div class="hidden text-right sm:block">
          <p class="text-sm font-semibold text-slate-900">
            <%= Current.user.name %>
          </p>
          <p class="text-xs text-slate-500">
            <%= Current.user.email_address %>
          </p>
        </div>

        <%= button_to "Sign out",
          session_path,
          method: :delete,
          class: "button-secondary" %>
      </div>
    </div>
  </header>

  <main id="main-content" class="mx-auto max-w-7xl px-4 py-8 sm:px-6 sm:py-12 lg:px-8">
    <header class="max-w-3xl">
      <p class="text-sm font-semibold uppercase tracking-[0.16em] text-emerald-700">
        Workspace overview
      </p>

      <h1 class="mt-3 text-3xl font-bold tracking-tight text-slate-950 sm:text-5xl">
        Welcome, <%= Current.user.name.split.first %>.
      </h1>

      <p class="mt-4 text-base leading-7 text-slate-600 sm:text-lg">
        Your account is active. Resources, availability rules, and protected
        reservation windows will be added to this workspace next.
      </p>
    </header>

    <section class="mt-10 grid gap-5 sm:grid-cols-3" aria-label="Workspace totals">
      <% [
        ["Resources", "0", "No rooms or equipment configured"],
        ["Upcoming bookings", "0", "Your schedule is currently clear"],
        ["Pending requests", "0", "Nothing needs a decision"]
      ].each do |label, value, detail| %>
        <article class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
          <p class="text-sm font-semibold text-slate-500"><%= label %></p>
          <p class="mt-3 text-4xl font-bold tracking-tight text-slate-950"><%= value %></p>
          <p class="mt-2 text-sm leading-6 text-slate-500"><%= detail %></p>
        </article>
      <% end %>
    </section>

    <div class="mt-6 grid gap-6 lg:grid-cols-[minmax(0,1fr)_22rem]">
      <section class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
        <header class="flex items-center justify-between border-b border-slate-200 px-5 py-4 sm:px-6">
          <div>
            <h2 class="font-bold text-slate-950">Today’s schedule</h2>
            <p class="mt-1 text-sm text-slate-500">
              <%= Date.current.to_fs(:long) %>
            </p>
          </div>

          <span class="rounded-full bg-emerald-50 px-3 py-1 text-xs font-semibold text-emerald-800">
            All clear
          </span>
        </header>

        <div class="flex min-h-72 flex-col items-center justify-center px-6 py-12 text-center">
          <span class="flex size-14 items-center justify-center rounded-xl bg-slate-100 text-2xl" aria-hidden="true">
            ◫
          </span>

          <h3 class="mt-5 text-lg font-bold text-slate-950">
            No bookings yet
          </h3>

          <p class="mt-2 max-w-sm text-sm leading-6 text-slate-500">
            Confirmed reservations will appear here after resources are added
            to the workspace.
          </p>
        </div>
      </section>

      <aside class="rounded-2xl bg-slate-950 p-6 text-white shadow-sm">
        <p class="text-xs font-semibold uppercase tracking-[0.16em] text-emerald-300">
          Account foundation
        </p>

        <h2 class="mt-3 text-xl font-bold">
          Ready for the booking domain.
        </h2>

        <div class="mt-6 space-y-5">
          <div>
            <p class="text-sm font-semibold">Persistent sessions</p>
            <p class="mt-1 text-sm leading-6 text-slate-400">
              Signed cookies resume a server-side session without storing
              credentials in the browser.
            </p>
          </div>

          <div>
            <p class="text-sm font-semibold">Password recovery</p>
            <p class="mt-1 text-sm leading-6 text-slate-400">
              Time-limited reset links replace passwords and revoke existing
              sessions.
            </p>
          </div>

          <div>
            <p class="text-sm font-semibold">Clear ownership</p>
            <p class="mt-1 text-sm leading-6 text-slate-400">
              Every future resource and reservation will belong to an explicit
              workspace member.
            </p>
          </div>
        </div>
      </aside>
    </div>
  </main>
</div>
