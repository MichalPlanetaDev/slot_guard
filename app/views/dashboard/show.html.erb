<% content_for :title, "Dashboard" %>
<% content_for :description, "Your SlotGuard workspace." %>

<main id="main-content" class="mx-auto max-w-7xl px-4 py-8 sm:px-6 sm:py-12 lg:px-8">
  <header class="flex flex-col gap-5 sm:flex-row sm:items-end sm:justify-between">
    <div class="max-w-3xl">
      <p class="text-sm font-semibold uppercase tracking-[0.16em] text-emerald-700">
        <%= Current.workspace.name %>
      </p>

      <h1 class="mt-3 text-3xl font-bold tracking-tight text-slate-950 sm:text-5xl">
        Welcome, <%= Current.user.name.split.first %>.
      </h1>

      <p class="mt-4 text-base leading-7 text-slate-600 sm:text-lg">
        Keep shared-resource availability and confirmed reservations visible
        to the whole workspace.
      </p>
    </div>

    <%= link_to "New reservation",
      new_reservation_path,
      class: "button-primary shrink-0" %>
  </header>

  <section class="mt-10 grid gap-5 sm:grid-cols-3" aria-label="Workspace totals">
    <article class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
      <p class="text-sm font-semibold text-slate-500">
        Active resources
      </p>

      <p class="mt-3 text-4xl font-bold tracking-tight text-slate-950">
        <%= @resource_counts.values.sum %>
      </p>

      <p class="mt-2 text-sm leading-6 text-slate-500">
        Ready for availability configuration
      </p>
    </article>

    <article class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
      <p class="text-sm font-semibold text-slate-500">
        Rooms
      </p>

      <p class="mt-3 text-4xl font-bold tracking-tight text-slate-950">
        <%= @resource_counts.fetch("room", 0) %>
      </p>

      <p class="mt-2 text-sm leading-6 text-slate-500">
        Shared spaces in this workspace
      </p>
    </article>

    <article class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
      <p class="text-sm font-semibold text-slate-500">
        Equipment
      </p>

      <p class="mt-3 text-4xl font-bold tracking-tight text-slate-950">
        <%= @resource_counts.fetch("equipment", 0) %>
      </p>

      <p class="mt-2 text-sm leading-6 text-slate-500">
        Shared tools and devices
      </p>
    </article>
  </section>

  <div class="mt-6 grid gap-6 lg:grid-cols-2">
    <section class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
      <header class="flex items-center justify-between border-b border-slate-200 px-5 py-4 sm:px-6">
        <div>
          <h2 class="font-bold text-slate-950">
            Upcoming reservations
          </h2>

          <p class="mt-1 text-sm text-slate-500">
            The next confirmed bookings in UTC
          </p>
        </div>

        <%= link_to "View all",
          reservations_path,
          class: "text-link text-sm" %>
      </header>

      <% if @upcoming_reservations.any? %>
        <div class="divide-y divide-slate-200">
          <% @upcoming_reservations.each do |reservation| %>
            <%= link_to reservation,
              class: "block px-5 py-4 transition hover:bg-slate-50 sm:px-6" do %>
              <div class="flex items-start justify-between gap-4">
                <div class="min-w-0">
                  <p class="truncate text-sm font-semibold text-slate-950">
                    <%= reservation.purpose %>
                  </p>

                  <p class="mt-1 truncate text-xs text-slate-500">
                    <%= reservation.shared_resource.name %>
                    ·
                    <%= reservation.user.name %>
                  </p>
                </div>

                <time
                  datetime="<%= reservation.starts_at.iso8601 %>"
                  class="shrink-0 text-right text-xs font-semibold text-emerald-700"
                >
                  <%= reservation.starts_at.to_fs(:short) %>
                  UTC
                </time>
              </div>
            <% end %>
          <% end %>
        </div>
      <% else %>
        <div class="flex min-h-64 flex-col items-center justify-center px-6 py-12 text-center">
          <h3 class="text-lg font-bold text-slate-950">
            No upcoming reservations
          </h3>

          <p class="mt-2 max-w-sm text-sm leading-6 text-slate-500">
            Add availability to a resource, then reserve a time inside one of
            its windows.
          </p>

          <%= link_to "Create a reservation",
            new_reservation_path,
            class: "button-primary mt-6" %>
        </div>
      <% end %>
    </section>

    <section class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
      <header class="flex items-center justify-between border-b border-slate-200 px-5 py-4 sm:px-6">
        <div>
          <h2 class="font-bold text-slate-950">
            Active resources
          </h2>

          <p class="mt-1 text-sm text-slate-500">
            Rooms and equipment available to configure
          </p>
        </div>

        <%= link_to "View all",
          shared_resources_path,
          class: "text-link text-sm" %>
      </header>

      <% if @active_resources.any? %>
        <div class="divide-y divide-slate-200">
          <% @active_resources.each do |shared_resource| %>
            <%= link_to shared_resource,
              class: "flex items-center justify-between gap-4 px-5 py-4 transition hover:bg-slate-50 sm:px-6" do %>
              <div class="min-w-0">
                <p class="truncate text-sm font-semibold text-slate-950">
                  <%= shared_resource.name %>
                </p>

                <p class="mt-1 truncate text-xs text-slate-500">
                  <%= [
                    shared_resource.category.humanize,
                    shared_resource.location
                  ].compact_blank.join(" · ") %>
                </p>
              </div>

              <span class="text-sm font-semibold text-emerald-700">
                Open
              </span>
            <% end %>
          <% end %>
        </div>
      <% else %>
        <div class="flex min-h-64 flex-col items-center justify-center px-6 py-12 text-center">
          <h3 class="text-lg font-bold text-slate-950">
            No resources yet
          </h3>

          <p class="mt-2 max-w-sm text-sm leading-6 text-slate-500">
            Add the rooms or equipment your team needs to schedule.
          </p>

          <% if can_manage_resources? %>
            <%= link_to "Add the first resource",
              new_shared_resource_path,
              class: "button-primary mt-6" %>
          <% end %>
        </div>
      <% end %>
    </section>
  </div>
</main>
