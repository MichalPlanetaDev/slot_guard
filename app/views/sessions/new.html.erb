<% content_for :title, "Sign in" %>
<% content_for :description, "Sign in to SlotGuard." %>
<% content_for :auth_heading, "Welcome back" %>
<% content_for :auth_description, "Sign in to open your booking workspace." %>

<%= form_with url: session_path,
  scope: :session,
  class: "space-y-5" do |form| %>
  <div>
    <%= form.label :email_address, "Email address", class: "form-label" %>
    <%= form.email_field :email_address,
      required: true,
      autofocus: true,
      autocomplete: "username",
      inputmode: "email",
      value: params.dig(:session, :email_address),
      placeholder: "ada@example.com",
      class: "form-input" %>
  </div>

  <div data-controller="password-visibility">
    <div class="flex items-center justify-between gap-4">
      <%= form.label :password, class: "form-label" %>

      <button
        type="button"
        class="mb-2 rounded text-sm font-semibold text-slate-600 hover:text-slate-950 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-emerald-600"
        data-action="password-visibility#toggle"
        data-password-visibility-target="button"
        aria-pressed="false"
      >
        Show
      </button>
    </div>

    <%= form.password_field :password,
      required: true,
      autocomplete: "current-password",
      maxlength: 72,
      data: { password_visibility_target: "input" },
      class: "form-input" %>

    <p class="mt-2 text-right">
      <%= link_to "Forgot your password?",
        new_password_path,
        class: "text-link text-sm" %>
    </p>
  </div>

  <%= form.submit "Sign in",
    class: "button-primary w-full cursor-pointer" %>
<% end %>

<p class="mt-6 text-center text-sm text-slate-600">
  New to SlotGuard?
  <%= link_to "Create an account",
    new_registration_path,
    class: "text-link" %>
</p>
