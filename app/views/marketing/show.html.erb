<% content_for :title, "Conflict-safe shared resource booking" %>
<% content_for :description, "Reserve shared rooms and equipment without schedule collisions." %>

<div class="min-h-screen bg-stone-50">
  <header class="border-b border-slate-200 bg-white">
    <nav
      class="mx-auto flex max-w-7xl items-center justify-between px-4 py-4 sm:px-6 lg:px-8"
      aria-label="Primary navigation"
    >
      <%= link_to root_path,
        class: "inline-flex items-center gap-3 rounded-lg focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-emerald-600" do %>
        <span class="flex size-10 items-center justify-center rounded-lg bg-slate-950 font-black text-emerald-300">
          SG
        </span>
        <span class="text-lg font-bold tracking-tight text-slate-950">
          SlotGuard
        </span>
      <% end %>

      <div class="flex items-center gap-2">
        <%= link_to "Sign in",
          new_session_path,
          class: "rounded-lg px-4 py-2 text-sm font-semibold text-slate-700 transition hover:bg-slate-100 hover:text-slate-950 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-emerald-600" %>

        <%= link_to "Create account",
          new_registration_path,
          class: "rounded-lg bg-slate-950 px-4 py-2.5 text-sm font-semibold text-white transition hover:bg-slate-800 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-emerald-600" %>
      </div>
    </nav>
  </header>

  <main id="main-content">
    <section class="border-b border-slate-200 bg-white">
      <div class="mx-auto grid max-w-7xl items-center gap-14 px-4 py-16 sm:px-6 sm:py-24 lg:grid-cols-[1fr_0.92fr] lg:px-8">
        <div>
          <p class="inline-flex items-center gap-2 rounded-full border border-emerald-200 bg-emerald-50 px-3 py-1.5 text-sm font-semibold text-emerald-800">
            <span class="size-2 rounded-full bg-emerald-600" aria-hidden="true"></span>
            Availability you can trust
          </p>

          <h1 class="mt-6 max-w-3xl text-4xl font-bold leading-tight tracking-tight text-slate-950 sm:text-6xl">
            Reserve shared equipment without double-booking it.
          </h1>

          <p class="mt-6 max-w-2xl text-lg leading-8 text-slate-600">
            SlotGuard gives small teams one clear schedule for rooms, tools,
            and equipment. Every confirmed reservation has an owner, a purpose,
            and a protected time window.
          </p>

          <div class="mt-8 flex flex-col gap-3 sm:flex-row">
            <%= link_to "Create an account",
              new_registration_path,
              class: "inline-flex min-h-12 items-center justify-center rounded-lg bg-emerald-600 px-5 py-3 text-base font-semibold text-white transition hover:bg-emerald-700 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-emerald-600" %>

            <a
              href="#workflow"
              class="button-secondary min-h-12 px-5 text-base"
            >
              See the workflow
            </a>
          </div>
        </div>

        <section
          class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-xl shadow-slate-950/5"
          aria-label="Schedule preview"
        >
          <header class="flex items-center justify-between border-b border-slate-200 px-5 py-4">
            <div>
              <p class="text-sm font-semibold text-slate-950">Tuesday schedule</p>
              <p class="mt-1 text-xs text-slate-500">Three shared resources</p>
            </div>

            <span class="rounded-full bg-emerald-50 px-3 py-1 text-xs font-semibold text-emerald-800">
              Live preview
            </span>
          </header>

          <div class="space-y-3 p-5">
            <% [
              ["Studio A", "09:00–10:30", "Booked"],
              ["Camera 2", "10:30–12:00", "Open"],
              ["Workshop", "13:00–15:00", "Booked"]
            ].each do |resource, time, status| %>
              <div class="flex items-center justify-between gap-4 rounded-xl border border-slate-200 p-4">
                <div>
                  <p class="text-sm font-semibold text-slate-950"><%= resource %></p>
                  <p class="mt-1 text-xs text-slate-500"><%= time %></p>
                </div>

                <span class="rounded-full px-3 py-1 text-xs font-semibold <%= status == "Open" ? "bg-emerald-50 text-emerald-800" : "bg-slate-100 text-slate-700" %>">
                  <%= status %>
                </span>
              </div>
            <% end %>

            <div class="flex items-start gap-3 rounded-xl border border-emerald-200 bg-emerald-50 p-4">
              <span class="flex size-8 shrink-0 items-center justify-center rounded-full bg-emerald-100 font-bold text-emerald-800" aria-hidden="true">
                ✓
              </span>

              <div>
                <p class="text-sm font-semibold text-slate-900">
                  Camera 2 is open at 10:30
                </p>

                <p class="mt-1 text-xs leading-5 text-slate-600">
                  Availability is checked again when a reservation is saved.
                </p>
              </div>
            </div>
          </div>
        </section>
      </div>
    </section>

    <section id="workflow" class="mx-auto max-w-7xl px-4 py-16 sm:px-6 sm:py-20 lg:px-8">
      <div class="max-w-2xl">
        <p class="text-sm font-semibold uppercase tracking-[0.16em] text-emerald-700">
          A focused booking workflow
        </p>

        <h2 class="mt-3 text-3xl font-bold tracking-tight text-slate-950 sm:text-4xl">
          Clear enough for daily use, strict enough for concurrent requests.
        </h2>
      </div>

      <div class="mt-10 grid gap-5 md:grid-cols-3">
        <% [
          ["01", "Review real availability", "See each resource on one schedule instead of comparing messages and spreadsheets."],
          ["02", "Record a complete request", "Keep the time window, purpose, requester, and resource together."],
          ["03", "Commit without collisions", "Recheck availability where simultaneous requests cannot bypass the rule."]
        ].each do |number, heading, copy| %>
          <article class="rounded-2xl border border-slate-200 bg-white p-6">
            <p class="text-sm font-semibold text-emerald-700"><%= number %></p>
            <h3 class="mt-5 text-lg font-bold text-slate-950"><%= heading %></h3>
            <p class="mt-2 text-sm leading-6 text-slate-600"><%= copy %></p>
          </article>
        <% end %>
      </div>
    </section>
  </main>

  <footer class="border-t border-slate-200 bg-white">
    <div class="mx-auto flex max-w-7xl flex-col gap-2 px-4 py-7 text-sm text-slate-500 sm:flex-row sm:items-center sm:justify-between sm:px-6 lg:px-8">
      <p>SlotGuard</p>
      <p>Shared resource booking with explicit ownership and protected time.</p>
    </div>
  </footer>
</div>
