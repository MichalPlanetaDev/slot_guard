#!/usr/bin/env bash
set -Eeuo pipefail

APP_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
MISE_BIN="${MISE_BIN:-$HOME/.local/bin/mise}"

if [[ ! -x "$MISE_BIN" ]]; then
  printf "mise not found at %s.\n" "$MISE_BIN" >&2
  exit 1
fi

cd "$APP_DIR"

if ! "$MISE_BIN" exec -- bundle check >/dev/null 2>&1; then
  "$MISE_BIN" exec -- bundle install
fi

exec "$MISE_BIN" exec -- \
  bundle exec foreman start -f Procfile.dev "$@"
